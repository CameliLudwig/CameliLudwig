{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MSVC Debug (build & launch)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\debug\\ProtectiveAcquisitionDrive.exe",
      "args": [],
      "cwd": "${workspaceFolder}\\build\\debug",
      "stopAtEntry": false,
      "externalConsole": true,
      "environment": [
        {
          "name": "PATH",
          "value": "D:/QT/5.12.9/5.12.9/msvc2017_64/bin;${workspaceFolder};${env:PATH}"
        }
      ],
      "preLaunchTask": "build-msvc"
    },
    {
      "name": "MinGW Debug (build & launch)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\debug\\ProtectiveAcquisitionDrive.exe",
      "args": [],
      "cwd": "${workspaceFolder}\\build\\debug",
      "stopAtEntry": false,
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "preLaunchTask": "build-mingw",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Attach to Process",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/new/ProtectiveAcquisitionDrive",
      "program": "d:/new/ProtectiveAcquisitionDrive/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}