/* ============ 全局背景 ============ */
QMainWindow {
    border-image: url(:/test.png);
}

QWidget#centralWidget {
    background-color: transparent;
}

/* ============ QGroupBox 卡片化 ============ */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f5f6f8);
    border: 1px solid #d0d5dc;
    border-left: 4px solid #34495e;
    border-radius: 8px;
    margin-top: 18px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: bold;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 4px 16px;
    background-color: #34495e;
    color: #ffffff;
    border-radius: 12px;
    font-size: 12px;
}

/* ============ 按钮 ============ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5a6c7d, stop:1 #3d4f5f);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6c7f91, stop:1 #4d6073);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3d4f5f, stop:1 #2c3e50);
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton:disabled {
    background: #bdc3c7;
    color: #95a5a6;
}

/* 启动自检 — 绿色 */
QPushButton#pushButton_SelectAll {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71, stop:1 #27ae60);
}
QPushButton#pushButton_SelectAll:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3ddb84, stop:1 #2ecc71);
}
QPushButton#pushButton_SelectAll:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60, stop:1 #1e8449);
}

/* 打开 — 蓝色 */
QPushButton#pushButton_open {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db, stop:1 #2980b9);
}
QPushButton#pushButton_open:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4da8e8, stop:1 #3498db);
}

/* 撤弹 — 红色 */
QPushButton#pushButton_WithdrawalOfAmmunition {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e74c3c, stop:1 #c0392b);
}
QPushButton#pushButton_WithdrawalOfAmmunition:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f06050, stop:1 #e74c3c);
}

/* 自毁 — 深红色 */
QPushButton#pushButton_SelfDestruct {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #c0392b, stop:1 #922b21);
    min-width: 120px;
}

/* 返回 — 灰色 */
QPushButton#pushButton_close {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #95a5a6, stop:1 #7f8c8d);
    min-width: 200px;
    font-size: 15px;
}
QPushButton#pushButton_close:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #aab7b8, stop:1 #95a5a6);
}

/* ============ QLineEdit / CircleLineEdit ============ */
QLineEdit {
    background: #ffffff;
    border: 2px solid #d0d5dc;
    border-radius: 6px;
    padding: 4px 8px;
    color: #2c3e50;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #3498db;
}

/* 告警数值框 — 大字 */
QLineEdit#lineEdit_PulseRepetitionPeriod,
QLineEdit#lineEdit_PulseWidth,
QLineEdit#lineEdit_2 {
    font-size: 14px;
    font-weight: bold;
}

/* ============ QRadioButton / QCheckBox ============ */
QRadioButton, QCheckBox {
    spacing: 6px;
    color: #2c3e50;
    font-size: 11px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #bdc3c7;
    border-radius: 3px;
    background: #ffffff;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2980b9;
    border-color: #2980b9;
}

QRadioButton::indicator {
    border-radius: 8px;
}

/* ============ QComboBox ============ */
QComboBox {
    background: #ffffff;
    border: 2px solid #d0d5dc;
    border-radius: 6px;
    padding: 6px 12px;
    color: #2c3e50;
    font-size: 13px;
    font-weight: bold;
    min-width: 90px;
    min-height: 28px;
}

QComboBox:hover { border-color: #3498db; }
QComboBox:focus { border-color: #2980b9; }

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d0d5dc;
    font-size: 13px;
    padding: 4px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

/* ============ QLabel ============ */
QLabel {
    color: #34495e;
    font-size: 11px;
}

/* ============ QMenuBar ============ */
QMenuBar {
    background-color: #2c3e50;
    color: #ecf0f1;
    padding: 2px;
}
QMenuBar::item:selected {
    background-color: #34495e;
}

/* ============ QStatusBar ============ */
QStatusBar {
    background-color: #ecf0f1;
    color: #7f8c8d;
}
